# =============================================================
#  Krono - variables de entorno
#  Copia este archivo:  cp .env.example .env   y edita los valores.
#  ¡Nunca subas el archivo .env a GitHub! (ya está en .gitignore)
# =============================================================

# ---------- Base de datos (PostgreSQL) ----------
POSTGRES_USER=krono
# Usa solo letras y números. Genera una con:  openssl rand -hex 24
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=krono

# ---------- Seguridad ----------
# Clave para firmar las sesiones (mínimo 32 caracteres).
# Genera una con:  openssl rand -base64 48
AUTH_SECRET=

# true  = cualquiera que abra la página puede crear una cuenta.
# false = se oculta el registro (recomendado cuando ya creaste tus cuentas
#         y la app está expuesta a internet).
ALLOW_REGISTRATION=true

# true solo si entras por HTTPS (por ejemplo detrás de Caddy).
# Con http://IP:8080 déjalo en false o no podrás iniciar sesión.
COOKIE_SECURE=false

# ---------- Red y zona horaria ----------
# Puerto donde se publica la app en la PC (http://IP:WEB_PORT)
WEB_PORT=8080
TZ=America/Mexico_City

# ---------- Solo si usas HTTPS con Caddy (deploy/) ----------
# Dominio que apunta a tu PC, por ejemplo: krono.midominio.com
KRONO_DOMAIN=

# ---------- Solo para desarrollo local (npm run dev) ----------
# Docker NO usa esta línea; arma su propia conexión con los datos de arriba.
DATABASE_URL=postgres://krono:cambia-esta-contrasena@localhost:5432/krono
